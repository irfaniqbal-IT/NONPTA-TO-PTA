# ===================== SECURITY (required) =====================
# Shared secret between this relay and the Android app (Settings -> Relay Auth Token).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The relay refuses to start if this is missing or shorter than 32 characters.
RELAY_AUTH_TOKEN=your_64_char_random_hex_token_here

# WebSocket port (Phone A connects here)
PORT=8080

# Interface to listen on. Use your LAN IP (e.g. 192.168.1.10) to avoid exposing
# the port on other interfaces, or 127.0.0.1 when running behind nginx/Caddy.
BIND_HOST=0.0.0.0

# Optional TLS (wss://). Required if the relay is reachable from the internet.
# Example with Let's Encrypt:
# TLS_CERT_FILE=/etc/letsencrypt/live/relay.example.com/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/relay.example.com/privkey.pem
TLS_CERT_FILE=
TLS_KEY_FILE=

# ===================== DISCORD =====================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_server_id_here
DISCORD_TEXT_CHANNEL_ID=your_calls_channel_id_here
DISCORD_VOICE_CHANNEL_ID=your_active_call_voice_channel_id_here
# Comma-separated Discord user IDs allowed to press Answer / Reject / End (required).
DISCORD_ALLOWED_USER_IDS=your_discord_user_id_here

# ===================== TELEGRAM (optional) =====================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Comma-separated Telegram user IDs allowed to press buttons.
# Leave empty in a private chat (then only the chat owner is allowed).
TELEGRAM_ALLOWED_USER_IDS=

# ===================== AUDIO BRIDGE =====================
# Linux PipeWire / PulseAudio Bluetooth HFP device names (blank/default = system default)
AUDIO_SOURCE_DEVICE=default
AUDIO_SINK_DEVICE=default
